# ═══════════════════════════════════════════════════════════════
#  تنظیمات زمان کامپایل
#  Test          flutter test --dart-define-from-file=app.env
#  Run           flutter run -d windows --dart-define-from-file=app.env
#  Build-Normal  flutter build windows --release --dart-define-from-file=app.env
#  Build-release  flutter build windows --release --obfuscate --dart-define-from-file=app.env --split-debug-info=debug-info
# ═══════════════════════════════════════════════════════════════


# ───────────── اسکن و خروجی ─────────────

# رزولوشن پیش‌فرض اسکن (DPI).
# وصل به: انتخاب رزولوشن در صفحه اسکن  +  تنظیمات > اسکن > رزولوشن پیش‌فرض
# مقدارهای معمول: 150  200  300  600  (باید دستگاه پشتیبانی کند)
DEFAULT_DPI=300

# کیفیت JPEG (عدد بین 1 تا 100؛ بیشتر = کیفیت بالاتر و حجم بیشتر).
# وصل به: خروجی JPG و PDF  +  تنظیمات > خروجی > کیفیت JPEG  +  لغزنده کیفیت در پنجره خروجی
JPEG_QUALITY=90

# حاشیه صفحه A4 / PDF بر حسب میلی‌متر.
# وصل به: حاشیه بالا/پایین/چپ/راست هنگام چیدمان روی A4  +  تنظیمات > خروجی > حاشیه پیش‌فرض صفحه
PAGE_MARGIN_MM=5


# ───────────── کارت و مدارک (چیدمان و خروجی) ─────────────

# اندازه کارت بر حسب میلی‌متر (استاندارد ID-1 = 85.60 × 53.98)
# وصل به: چیدمان و خروجی > اندازه کارت + تنظیمات > کارت و مدارک > اندازه کارت
CARD_WIDTH_MM=10  # 85.60
CARD_HEIGHT_MM=15      # 53.98

# فاصله بین کارت‌ها در چیدمان (میلی‌متر).
# وصل به: چیدمان و خروجی > حاشیه‌ها و فاصله > فاصله دو کارت
CARD_GAP_MM=5

# تعداد سطر پیش‌فرض شبکه چیدمان روی A4 (عدد 1 تا 12).
# وصل به: چیدمان و خروجی > تعداد سطر   (2 = روی کارت بالا، پشت کارت پایین)
CARD_ROWS=2

# تعداد ستون پیش‌فرض شبکه چیدمان (عدد 1 تا 12).
# وصل به: چیدمان و خروجی > تعداد ستون   (1 = زیر هم، 2 = کنار هم)
CARD_COLS=1

# تنظیم لبه برش خودکار کارت (میلی‌متر).
# عدد مثبت = برش بزرگ‌تر (برش کمتر)،  عدد منفی = برش کوچک‌تر. اگر کارت زیادی بریده می‌شود، عدد را بیشتر کنید.
# وصل به: چیدمان و خروجی > برش کارت > خودکار > تنظیم لبه برش
CARD_EDGE_MM=1

# رزولوشن خروجی نهایی کارت (DPI): 200 یا 300 یا 600.
# وصل به: چیدمان و خروجی > کیفیت خروجی (DPI)
CARD_OUTPUT_DPI=300

# حساسیت تشخیص خودکار کارت (0 تا 255).
# عدد کمتر = حساس‌تر (لبه‌های کم‌رنگ هم دیده می‌شود)،  عدد بیشتر = فقط لبه‌های پررنگ.
# وصل به: برش خودکار کارت (فقط وقتی «برش خودکار» روشن است)
DETECT_THRESHOLD=14


# ───────────── پیش‌نمایش چیدمان ─────────────

# اندازه ضلع بزرگ تصویر پیش‌نمایش چیدمان به پیکسل.
# بیشتر = شفاف‌تر ولی کندتر.
# وصل به: پیش‌نمایش در زبانه «چیدمان و خروجی»
PREVIEW_LONG_SIDE_PX=1800

# کمترین مقیاس پیش‌نمایش (پیکسل بر میلی‌متر).
# وصل به: پیش‌نمایش چیدمان
PREVIEW_MIN_PX_PER_MM=3

# بیشترین مقیاس پیش‌نمایش (پیکسل بر میلی‌متر). برای کارت‌های کوچک سقف شفافیت.
# وصل به: پیش‌نمایش چیدمان
PREVIEW_MAX_PX_PER_MM=14


# ───────────── ویرایشگر برش دستی (اندازه‌ها به پیکسل صفحه) ─────────────

# فاصله قابل کلیک بیرون تصویر؛ می‌توانید لبه‌ها را کمی بیرون از تصویر هم بگیرید.
# وصل به: پنجره «ویرایش صفحه / برش دستی»
CROP_HANDLE_PAD=56

# فاصله‌ای که با آن گوشه کادر برش گرفته می‌شود (بیشتر = گرفتن راحت‌تر).
# وصل به: پنجره برش دستی، گوشه‌ها
CROP_CORNER_HIT=52

# فاصله‌ای که با آن ضلع کادر برش (بالا/پایین/چپ/راست) گرفته می‌شود.
# وصل به: پنجره برش دستی، اضلاع
CROP_EDGE_HIT=44

# حداقل اندازه کادر برش (درصد از تصویر)، تا اضلاع روی هم نیفتند.
# وصل به: پنجره برش دستی
CROP_MIN_SIZE_PERCENT=5
